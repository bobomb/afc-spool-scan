# Scripted tour of the touch UI against the simulated service.
#
#   python -m station --hardware sim --printers sim --spoolman sim --writes off
#   station-ui --snapshot out/tour --connect --script ui/scripts/tour.script
#
# Coordinates are for the 800x480 layout: side rail x 0-72 (Station y 42, Printers 110,
# Log 178, Settings 438), top spool box y 12-140, printer cards y 174-352 (Kilo x 88-428,
# Yankee x 444-784), action bar y 364-424 (More 136, Weigh 267, Load 425, Weigh + Load 646).
# Requests go through the UI's own IPC connection, so sim.* actions only work while the
# service is simulated.

screen main
request sim.scale {"grams": 0}
wait 400
shot 01-start

# Tap the top box, type a spool ID, look it up.
tap 300 76
wait 300
type 97
shot 02-keypad
tap 520 398
wait 600
request sim.scale {"grams": 640}
wait 400
shot 03-lookup

# Tapping a printer card changes nothing: Load always goes to both printers.
tap 614 200
wait 300

# Weigh + Load to both printers.
tap 646 394
wait 900
shot 04-weigh-load

# Kilo's lane4 takes the spool, so Yankee's next spool is cleared automatically.
request sim.printer {"printer": "kilo", "op": "insert", "lane": "lane4"}
wait 900
shot 05-loaded-in-kilo
request sim.printer {"printer": "kilo", "op": "eject", "lane": "lane4"}
wait 400

# Printers screen; tap Kilo lane4 to assign the spool.
tap 36 110
wait 300
shot 06-printers
tap 260 328
wait 300
shot 07-assign-dialog
tap 554 404
wait 900
shot 08-assigned

# Log, then undo the assignment from the result line.
tap 36 178
wait 300
shot 09-log
tap 732 452
wait 900
shot 10-undo

# Sanity check: 984 g is far from the expected 634.7 g, so Weigh asks first.
tap 36 42
request sim.scale {"grams": 984}
wait 400
tap 267 394
wait 700
shot 11-confirm
tap 514 377
wait 900
shot 12-confirmed

# A scan in immediate mode with a suspicious weight prompts on screen.
request sim.scan {"code": "WEB+SPOOLMAN:S-86"}
wait 1200
shot 13-scan-prompt
tap 236 377
wait 600

# Countdown scan mode, cancelled from the overlay.
request set_setting {"key": "scan_mode", "value": "countdown"}
request sim.scan {"code": "web+spoolman:s-90"}
wait 1600
shot 14-countdown
tap 400 342
wait 600
shot 15-countdown-cancelled
request set_setting {"key": "scan_mode", "value": "immediate"}

# A multi-colour spool fills its tile with a gradient.
tap 300 76
wait 300
type 93
tap 520 398
wait 800
shot 16-multicolor

# More: record spool 93 as empty (141 g core, known tare 140 g).
request sim.scale {"grams": 141}
wait 500
tap 136 394
wait 300
shot 17-more-menu
tap 224 320
wait 400
shot 18-empty-dialog
tap 514 349
wait 900
shot 19-empty-recorded

# Clear deselects the spool.
tap 300 76
wait 300
tap 280 398
wait 300
tap 560 52
wait 600
shot 20-no-spool

# A printer drops off the network.
request sim.printer {"printer": "yankee", "op": "disconnect"}
wait 600
shot 21-printer-offline
tap 36 110
wait 300
shot 22-printers-offline
request sim.printer {"printer": "yankee", "op": "connect"}

# Light theme from Settings.
tap 36 438
wait 300
tap 683 115
wait 1500
shot 23-light-settings
tap 36 42
wait 300
shot 24-light-main
request set_setting {"key": "theme", "value": "dark"}
wait 1200

# Sleep: a scan in immediate mode sets the next spool on both printers; when the screen goes
# off the spool is deselected and both pending next spools are cleared.
request sim.scan {"code": "web+spoolman:s-97"}
wait 1200
idle off
wait 900
shot 25-blank
idle wake
wait 300
shot 26-woken
