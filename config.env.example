# Copy this file to config.env only when you need to override a default.

EVENT_DEV="/dev/input/by-id/usb-TMS_HIDKeyBoard_1234567890abcd-event-kbd"
MOONRAKER_HOSTS="kilo.local,yankee.local"
MOONRAKER_PORT="7125"
SPOOLMAN_URL="http://127.0.0.1:7912/api/v1"

# DYMO M5/M10 defaults.
SCALE_VENDOR_ID="0922"
SCALE_PRODUCT_IDS="8003"
SCALE_READ_TIMEOUT_SECONDS="2"
SCALE_MINIMUM_WEIGHT_GRAMS="50"

# auto/alsa uses a connected speaker. For an active buzzer, select gpio and
# set a free BCM GPIO number (the buzzer's other lead connects to ground).
AUDIO_BACKEND="auto"
AUDIO_DEVICE=""
BUZZER_GPIO_PIN=""

# Spool station service (python -m station; see docs/touch-ui-dev-plan.md §4).
# The existing bash scripts ignore these keys. Defaults: Windows = sim/sim/sim
# with writes off; Linux = real/live/live with writes on.
# PRINTERS order is the left-to-right order of the printer cards; the cards
# show each printer's Mainsail name when it has one.
#PRINTERS="Kilo=192.0.2.11:7125,Yankee=192.0.2.12:7125"
#STATION_HARDWARE="real"
#STATION_PRINTERS="live"
#STATION_SPOOLMAN="live"
#STATION_WRITES="on"
#STATION_IPC_HOST="127.0.0.1"
#STATION_IPC_PORT="7913"
#STATION_STATE_DIR=""
#STATION_LOG_LEVEL="INFO"
#STATION_SIM_FIXTURES=""
#SPOOLMAN_PREFIX="web+spoolman:s-"