# Copy this file to config.env only when you need to override a default.

EVENT_DEV="/dev/input/by-id/usb-TMS_HIDKeyBoard_1234567890abcd-event-kbd"
MOONRAKER_HOSTS="kilo.local,yankee.local"
MOONRAKER_PORT="7125"
SPOOLMAN_URL="http://127.0.0.1:7912/api/v1"

# Encode this exact text in the weighing-trigger QR code.
WEIGH_TRIGGER_CODE="afc-weigh-spool"
WEIGH_WINDOW_SECONDS="5"

# DYMO M5/M10 defaults.
SCALE_VENDOR_ID="0922"
SCALE_PRODUCT_IDS="8003"
SCALE_READ_TIMEOUT_SECONDS="2"

# auto/alsa uses a connected speaker. For an active buzzer, select gpio and
# set a free BCM GPIO number (the buzzer's other lead connects to ground).
AUDIO_BACKEND="auto"
AUDIO_DEVICE=""
BUZZER_GPIO_PIN=""